{
  "name": "fiscaldiff",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Workforce budget-impact application for municipal finance staff. Synthetic demo data only.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
